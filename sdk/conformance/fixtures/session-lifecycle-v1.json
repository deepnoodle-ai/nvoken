{
  "version": 1,
  "description": "Wire shapes for the Session options, host metadata, and provider server-side tools each SDK builds by hand. Four independently written request builders converge here so a field one binding spells differently is a failing test rather than a silently dropped option.",
  "session_options": {
    "retention_only": {
      "retention": {
        "ttl_seconds": 86400
      }
    },
    "authorization_context_only": {
      "authorization_context": {
        "board": "brand-2026",
        "trace_id": "018f-4a"
      }
    },
    "every_member": {
      "compaction": {
        "trigger_tokens": 32768
      },
      "retention": {
        "ttl_seconds": 3600
      },
      "authorization_context": {
        "surface": "web"
      },
      "pinned_revision": 4,
      "on_conflict": "join"
    }
  },
  "retention_bounds": {
    "min_ttl_seconds": 3600,
    "max_ttl_seconds": 2592000
  },
  "invocation_metadata": {
    "board": "brand-2026",
    "surface": "web"
  },
  "metadata_bounds": {
    "max_entries": 16,
    "max_key_bytes": 64,
    "max_value_bytes": 512
  },
  "metadata_patch": {
    "request": {
      "metadata": {
        "title": "Refund policy",
        "trace_id": null
      }
    },
    "note": "A present key replaces, an explicit null deletes, an absent key survives. `\"metadata\": null` is refused rather than guessed at."
  },
  "agent_request": {
    "note": "The complete request body each SDK's high-level Agent binding produces from an App-owned Agent Definition, agent_key `support`, input `hello`, and idempotency key `conformance`.",
    "web_search_metadata_unbound": {
      "agent_key": "support",
      "idempotency_key": "conformance",
      "on_budget_exhausted": "hold",
      "input": "hello",
      "metadata": {
        "board": "brand-2026",
        "surface": "web"
      },
      "session_options": {
        "retention": {
          "ttl_seconds": 86400
        }
      }
    }
  },
  "provider_tools": {
    "defaults": [
      {
        "type": "web_search",
        "web_search": {}
      }
    ],
    "configured": [
      {
        "type": "web_search",
        "web_search": {
          "max_uses": 5,
          "allowed_domains": [
            "example.com",
            "docs.example.com"
          ],
          "user_location": {
            "city": "Austin",
            "region": "Texas",
            "country": "US",
            "timezone": "America/Chicago"
          }
        }
      }
    ]
  }
}
