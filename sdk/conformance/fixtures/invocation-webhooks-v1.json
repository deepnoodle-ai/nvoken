{
  "version": 1,
  "note": "Invocation webhooks are opt-in per Invocation and are delivered as signed HTTPS POSTs. Every SDK must transmit the target verbatim, and the payload every SDK documents must stay a pointer to authoritative state rather than a copy of it.",
  "events": [
    "invocation.ended",
    "invocation.waiting",
    "invocation.paused"
  ],
  "default_events_when_omitted": [
    "invocation.ended",
    "invocation.waiting",
    "invocation.paused"
  ],
  "default_note": "Omitting events selects every event. The harmful default is the one that quietly drops invocation.waiting and leaves a parked host tool loop with nobody listening.",
  "rejected_events": [
    "invocation.queued",
    "invocation.running",
    "invocation.completed",
    "message.appended",
    "waiting"
  ],
  "rejected_urls": [
    "http://host.example.com/hook",
    "https://user:pass@host.example.com/hook",
    "https://host.example.com/hook#fragment",
    "ftp://host.example.com/hook",
    "/relative/hook",
    ""
  ],
  "content_type": "application/vnd.nvoken.invocation-webhook+json; version=1",
  "signature": {
    "version": "v1",
    "canonical_string": "v1.<delivery_id>.<timestamp>.<body>",
    "signature_header": "X-Nvoken-Signature",
    "signature_prefix": "sha256=",
    "timestamp_header": "X-Nvoken-Timestamp",
    "delivery_id_header": "X-Nvoken-Delivery-Id",
    "idempotency_key_header": "Idempotency-Key",
    "idempotency_key_is": "webhook_id",
    "note": "Identical to the tool-callback scheme so a host implements one verification path. Only the content type and the idempotency key's meaning differ."
  },
  "payload_fields": {
    "nvoken": [
      "schema_version",
      "delivery_id",
      "event",
      "sequence",
      "invocation_id",
      "session_id",
      "agent_key",
      "tenant_key"
    ],
    "invocation": [
      "status",
      "stop_reason",
      "failure_code",
      "waiting_tool_call_ids"
    ]
  },
  "ended_statuses": [
    "completed",
    "incomplete",
    "failed",
    "cancelled"
  ],
  "ended_statuses_note": "invocation.ended reports whichever terminal status the Invocation reached, so a host that treats only 'completed' as an ending stalls on 'incomplete'. Only 'failed' carries failure_code; non-failure endings carry stop_reason.",
  "payload_absent_fields": [
    "messages",
    "output_text",
    "structured_output",
    "usage",
    "provenance",
    "failure_message",
    "tool_input",
    "tool_result"
  ],
  "delivery": {
    "guarantee": "at_least_once",
    "ordering": "per_invocation_by_sequence",
    "ordering_note": "A webhook is claimable only when every lower-sequence webhook for the same Invocation is terminal, so invocation.ended never arrives before an invocation.waiting or invocation.paused event that preceded it. Head-of-line blocking is scoped to one Invocation.",
    "success_statuses": "2xx",
    "retryable_statuses": [408, 425, 429, 500, 502, 503, 504],
    "permanent_statuses": [400, 401, 403, 404, 409, 410, 422],
    "response_body_is_ignored": true,
    "never_affects_invocation": true
  },
  "example_request": {
    "agent_key": "support-bot",
    "session_key": "ticket-4417",
    "idempotency_key": "req-1",
    "webhook": {
      "url": "https://host.example.com/nvoken/webhooks",
      "events": ["invocation.ended", "invocation.waiting", "invocation.paused"]
    },
    "model": {
      "provider": "anthropic",
      "id": "claude-sonnet-4-5"
    },
    "input": [{ "type": "text", "text": "Where is my order?" }]
  },
  "example_ended_payload": {
    "nvoken": {
      "schema_version": 1,
      "delivery_id": "invn_019b0a12-0000-7000-8000-000000000001",
      "event": "invocation.ended",
      "sequence": 2,
      "invocation_id": "invk_019b0a12-0000-7000-8000-000000000001",
      "session_id": "sesn_019b0a12-0000-7000-8000-000000000001",
      "agent_key": "support-bot",
      "tenant_key": "acme"
    },
    "invocation": {
      "status": "failed",
      "failure_code": "context_window_exceeded"
    }
  },
  "example_waiting_payload": {
    "nvoken": {
      "schema_version": 1,
      "delivery_id": "invn_019b0a12-0000-7000-8000-000000000002",
      "event": "invocation.waiting",
      "sequence": 1,
      "invocation_id": "invk_019b0a12-0000-7000-8000-000000000001",
      "session_id": "sesn_019b0a12-0000-7000-8000-000000000001",
      "agent_key": "support-bot",
      "tenant_key": "acme"
    },
    "invocation": {
      "status": "waiting",
      "waiting_tool_call_ids": ["tcal_019b0a12-0000-7000-8000-000000000001"]
    }
  },
  "example_paused_payload": {
    "nvoken": {
      "schema_version": 1,
      "delivery_id": "invn_019b0a12-0000-7000-8000-000000000003",
      "event": "invocation.paused",
      "sequence": 2,
      "invocation_id": "invk_019b0a12-0000-7000-8000-000000000001",
      "session_id": "sesn_019b0a12-0000-7000-8000-000000000001",
      "agent_key": "support-bot",
      "tenant_key": "acme"
    },
    "invocation": {
      "status": "paused",
      "stop_reason": "session_max_estimated_cost"
    }
  }
}
